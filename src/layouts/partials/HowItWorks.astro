---
import MermaidDiagram from "@/components/MermaidDiagram";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";

const sectionData = await getListPage("howItWorksSection", "how-it-works");
if (!sectionData.data.enable) {
  return null;
}

const { id, title, description, steps, diagram } = sectionData.data;
---

<section class="section" id={id}>
  <div class="container">
    <div class="relative overflow-hidden rounded-2xl p-7 md:p-10 lg:p-16">
      <div
        class="flex flex-col justify-start items-center relative text-center z-10 lg:gy-0"
      >
        <div class="lg:col-5">
          <h2
            set:html={markdownify(title)}
            class="has-gradient mb-6"
            data-aos="fade-up-sm"
          />
          <div data-aos="fade-up-sm" data-aos-delay="50">
            <div
              set:html={markdownify(description)}
              class="text-2xl/[inherit]"
            />
          </div>
        </div>

        <div class="col-12 pt-20 w-full">
          <div class="row g-4 justify-center">
            {
              steps.map((step, index) => (
                <div
                  class="md:col-6 lg:col-5"
                  data-aos="fade-up-sm"
                  data-aos-delay={index * 100}
                >
                  <div class="min-h-full overflow-hidden rounded-lg border border-white/5 bg-dark p-9 text-left">
                    <h3
                      class="tracking-none mb-4 text-xl/snug"
                      set:html={markdownify(step.title)}
                    />
                    <p class="opacity-60" set:html={markdownify(step.description)} />
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="content w-full pt-16" data-aos="fade-up-sm">
          <MermaidDiagram client:visible chart={diagram} />
        </div>
      </div>
    </div>
  </div>
</section>
